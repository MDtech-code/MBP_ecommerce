      "Password must be at least 8 characters.";

    renderPage();

    expect(
      screen.getByText(
        "Password must be at least 8 characters.",
      ),
    ).toBeInTheDocument();
  });

  it("shows confirm new password field error", () => {
    hookState.confirmNewPasswordError =
      "Passwords do not match.";

    renderPage();

    expect(
      screen.getByText("Passwords do not match."),
    ).toBeInTheDocument();
  });
});
