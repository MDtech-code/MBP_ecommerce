const mockSuccessEnvelope = (data, message = "Success.") => ({
  data: {
    success: true,
    message,
    data,
    errors: null,
    meta: { request_id: "test-123" },
  },
});

const mockErrorEnvelope = (errors, message = "Failed.") => ({
  data: {
    success: false,
    message,
    data: null,
    errors,
