        current_password: "wrong",
        new_password: "NewPass456!",
        confirm_new_password: "NewPass456!",
      });
    });

    await waitFor(() =>
      expect(result.current.isError).toBe(true),
    );

    expect(result.current.error).toBe(mockError);
  });
});
