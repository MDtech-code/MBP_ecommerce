  it("renders current password input", () => {
    renderPage();

    expect(
      screen.getByPlaceholderText("Enter current password"),
    ).toBeInTheDocument();
  });

  it("renders new password input", () => {
    renderPage();

    expect(
      screen.getByPlaceholderText("Enter new password"),
    ).toBeInTheDocument();
  });

  it("renders confirm password input", () => {
    renderPage();

    expect(
